{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "./build.sh",
  "builds": [
    {
      "src": "DHH/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "DHH/wsgi.py"
    }
  ]
}
