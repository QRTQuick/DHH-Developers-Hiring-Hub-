{
  "version": 2,
  "builds": [
    {
      "src": "backend/run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/run.py"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "backend/run.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/run.py"
    }
  ],
  "outputDirectory": "backend/frontend"
}
