{
  "version": 2,
  "builds": [
    {
      "src": "backend/run.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "backend/run.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/run.py"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "backend/run.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/run.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  }
}
